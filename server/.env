# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Database URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_launchpad?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_launchpad

# JWT Authentication Secrets
JWT_SECRET=ai_launchpad_jwt_super_secret_key_2026_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=ai_launchpad_token

# Razorpay Test Credentials (Never expose Key Secret to client)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret12345
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecret67890

# Seed Default Admin Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@ailaunchpad.edu
ADMIN_PASSWORD=AdminLaunchpad2026!
