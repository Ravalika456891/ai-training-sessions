# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Database URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_launchpad?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_launchpad

# JWT Secrets
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=ai_launchpad_token

# Admin Seed
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@ailaunchpad.edu
ADMIN_PASSWORD=AdminLaunchpad2026!

